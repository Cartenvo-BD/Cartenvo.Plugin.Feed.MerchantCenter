<style>
    .mc { --mc-brand: #2563eb; --mc-brand-dark: #1d4ed8; --mc-brand-soft: #eff6ff; --mc-ink: #0f172a; --mc-text: #334155;
          --mc-muted: #64748b; --mc-line: #e2e8f0; --mc-soft: #f8fafc; --mc-ok: #16a34a; --mc-ok-bg: #dcfce7;
          --mc-warn: #b45309; --mc-warn-bg: #fef3c7; --mc-bad: #dc2626; --mc-bad-bg: #fee2e2; --mc-info: #0369a1; --mc-info-bg: #e0f2fe;
          --mc-radius: 14px; --mc-shadow: 0 1px 2px rgba(15,23,42,.05), 0 4px 16px rgba(15,23,42,.04);
          color: var(--mc-text); padding: 18px 8px 32px; max-width: 1360px; }
    .mc *, .mc *::before, .mc *::after { box-sizing: border-box; }
    .mc a { color: var(--mc-brand); }
    .mc h2, .mc h3, .mc h4 { color: var(--mc-ink); }
    .mc .muted { color: var(--mc-muted); }
    .mc .small { font-size: .85rem; }
    .mc .mono { font-family: SFMono-Regular, Consolas, "Liberation Mono", monospace; font-size: .82rem; }

    /* Title bar and tabs */
    .mc-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 24px; margin-bottom: 22px; }
    .mc-brand { display: flex; align-items: center; gap: 14px; min-width: 0; }
    .mc-brand img { border-radius: 12px; box-shadow: 0 4px 14px rgba(37,99,235,.28); flex: 0 0 auto; }
    .mc-brand h1 { font-size: 1.45rem; font-weight: 700; margin: 0; color: var(--mc-ink); line-height: 1.2; }
    .mc-brand p { margin: 2px 0 0; color: var(--mc-muted); font-size: .9rem; }
    .mc-tabs { display: flex; gap: 4px; background: #fff; border: 1px solid var(--mc-line); border-radius: 12px; padding: 4px; box-shadow: var(--mc-shadow); overflow-x: auto; max-width: 100%; }
    .mc-tabs a { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 9px; color: var(--mc-text) !important; font-weight: 500; font-size: .92rem; white-space: nowrap; text-decoration: none !important; transition: background .15s, color .15s; }
    .mc-tabs a i { color: var(--mc-muted); font-size: .9em; }
    .mc-tabs a:hover { background: var(--mc-soft); }
    .mc-tabs a.active { background: var(--mc-brand); color: #fff !important; box-shadow: 0 2px 8px rgba(37,99,235,.35); }
    .mc-tabs a.active i { color: #fff; }
    .mc-tab-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; flex: none; }
    .mc-tab-dot.on { background: #16a34a; box-shadow: 0 0 0 3px rgba(22,163,74,.18); }
    .mc-tab-dot.started { background: #f59e0b; box-shadow: 0 0 0 3px rgba(245,158,11,.2); }
    .mc-tabs a.active .mc-tab-dot { box-shadow: 0 0 0 2px #fff; }
    .mc-tab-tag { font-style: normal; font-size: .7rem; font-weight: 600; line-height: 1; padding: 3px 6px; border-radius: 999px; background: var(--mc-soft); color: var(--mc-muted); border: 1px solid var(--mc-line); }
    .mc-tabs a.active .mc-tab-tag { background: rgba(255,255,255,.2); color: #fff; border-color: transparent; }

    /* Cards and layout */
    .mc-card { background: #fff; border: 1px solid var(--mc-line); border-radius: var(--mc-radius); box-shadow: var(--mc-shadow); padding: 22px; margin-bottom: 20px; }
    .mc-card > h3, .mc-card-title { font-size: 1.05rem; font-weight: 650; margin: 0 0 14px; display: flex; align-items: center; gap: 10px; }
    .mc-card-title .mc-spacer { margin-left: auto; }
    .mc-grid { display: grid; gap: 20px; }
    .mc-grid.two { grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr); }
    .mc-grid.halves { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    @@media (max-width: 1100px) { .mc-grid.two, .mc-grid.halves { grid-template-columns: 1fr; } }
    .mc-sticky { position: sticky; top: 70px; }
    .mc-intro { color: var(--mc-muted); margin: -6px 0 18px; max-width: 820px; }

    /* Buttons */
    .mc .mc-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 1px solid var(--mc-line); background: #fff; color: var(--mc-ink); border-radius: 10px; padding: 8px 14px; font-weight: 600; font-size: .9rem; cursor: pointer; text-decoration: none; transition: all .15s; line-height: 1.3; white-space: nowrap; }
    .mc .mc-btn:hover { border-color: #cbd5e1; background: var(--mc-soft); text-decoration: none; }
    .mc .mc-btn.primary { background: var(--mc-brand); border-color: var(--mc-brand); color: #fff; box-shadow: 0 2px 8px rgba(37,99,235,.3); }
    .mc .mc-btn.primary:hover { background: var(--mc-brand-dark); }
    .mc .mc-btn.lg { padding: 12px 22px; font-size: 1rem; border-radius: 12px; }
    .mc .mc-btn.sm { padding: 5px 10px; font-size: .82rem; border-radius: 8px; }
    .mc .mc-btn.ghost { border-color: transparent; background: transparent; }
    .mc .mc-btn.ghost:hover { background: var(--mc-soft); }
    .mc .mc-btn.danger { color: var(--mc-bad); }
    .mc .mc-btn.ok { background: var(--mc-ok); border-color: var(--mc-ok); color: #fff; }
    .mc .mc-btn[disabled] { opacity: .6; cursor: wait; }
    .mc .mc-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }

    /* Pills and chips */
    .mc-pill { display: inline-flex; align-items: center; gap: 6px; font-size: .75rem; font-weight: 650; padding: 3px 10px; border-radius: 99px; white-space: nowrap; }
    .mc-pill::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
    .mc-pill.nodot::before { display: none; }
    .mc-pill.ready, .mc-pill.ok { background: var(--mc-ok-bg); color: var(--mc-ok); }
    .mc-pill.attention, .mc-pill.warning { background: var(--mc-warn-bg); color: var(--mc-warn); }
    .mc-pill.failed, .mc-pill.error { background: var(--mc-bad-bg); color: var(--mc-bad); }
    .mc-pill.notbuilt, .mc-pill.paused, .mc-pill.muted { background: #f1f5f9; color: var(--mc-muted); }
    .mc-pill.info { background: var(--mc-info-bg); color: var(--mc-info); }
    .mc-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
    .mc-chip { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--mc-line); background: #fff; border-radius: 99px; padding: 6px 12px; font-size: .85rem; font-weight: 550; color: var(--mc-text) !important; text-decoration: none !important; transition: all .15s; }
    .mc-chip:hover { border-color: #94a3b8; }
    .mc-chip.active { background: var(--mc-ink); border-color: var(--mc-ink); color: #fff !important; }
    .mc-chip b { font-weight: 700; }
    .mc-chip .dot { width: 8px; height: 8px; border-radius: 50%; }
    .dot.error { background: var(--mc-bad); } .dot.warning { background: #f59e0b; } .dot.info { background: #0ea5e9; } .dot.muted { background: #94a3b8; }

    /* Welcome */
    .mc-hero { position: relative; overflow: hidden; border-radius: 20px; padding: 40px; margin-bottom: 22px; color: #fff;
               background: radial-gradient(circle at 85% 10%, rgba(250,204,21,.35), transparent 32%), linear-gradient(135deg, #1e3a8a 0%, #2563eb 55%, #3b82f6 100%); box-shadow: 0 12px 40px rgba(37,99,235,.25); }
    .mc-hero h2 { color: #fff; font-size: 2rem; font-weight: 750; margin: 0 0 10px; letter-spacing: -.01em; }
    .mc-hero p.lead { color: rgba(255,255,255,.88); font-size: 1.06rem; max-width: 640px; margin: 0 0 26px; }
    .mc-hero-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(320px, 1fr); gap: 32px; align-items: start; }
    @@media (max-width: 1000px) { .mc-hero-grid { grid-template-columns: 1fr; } .mc-hero { padding: 26px; } }
    .mc-steps { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
    .mc-steps li { display: flex; gap: 14px; align-items: flex-start; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.16); border-radius: 14px; padding: 14px 16px; backdrop-filter: blur(4px); }
    .mc-steps .num { flex: 0 0 34px; height: 34px; border-radius: 50%; background: #fff; color: var(--mc-brand); font-weight: 800; display: flex; align-items: center; justify-content: center; }
    .mc-steps b { display: block; color: #fff; }
    .mc-steps span { color: rgba(255,255,255,.82); font-size: .9rem; }
    .mc-hero .mc-free { margin-top: 18px; color: rgba(255,255,255,.8); font-size: .85rem; display: flex; gap: 8px; align-items: center; }
    .mc-quick { background: #fff; color: var(--mc-text); border-radius: 16px; padding: 22px; box-shadow: 0 10px 30px rgba(15,23,42,.25); }
    .mc-quick h3 { margin: 0 0 4px; font-size: 1.1rem; font-weight: 700; }
    .mc-quick p { color: var(--mc-muted); margin: 0 0 16px; font-size: .88rem; }

    /* Forms */
    .mc-field { margin-bottom: 16px; }
    .mc-field > label, .mc-label { display: block; font-weight: 600; color: var(--mc-ink); font-size: .9rem; margin-bottom: 6px; }
    .mc-field .hint, .mc-hint { color: var(--mc-muted); font-size: .82rem; margin-top: 5px; }
    .mc .mc-input, .mc select.mc-input { width: 100%; border: 1px solid #cbd5e1; border-radius: 10px; padding: 9px 12px; font-size: .93rem; background: #fff; color: var(--mc-ink); transition: border-color .15s, box-shadow .15s; height: auto; }
    .mc .mc-input:focus { outline: 0; border-color: var(--mc-brand); box-shadow: 0 0 0 3px rgba(37,99,235,.15); }
    .mc-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16px; }
    @@media (max-width: 700px) { .mc-row { grid-template-columns: 1fr; } }
    .mc-section { border-top: 1px solid var(--mc-line); padding-top: 18px; margin-top: 6px; }
    .mc-section:first-child { border-top: 0; padding-top: 0; margin-top: 0; }
    .mc-section h4 { font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; color: var(--mc-muted); font-weight: 700; margin: 0 0 14px; }

    /* Toggle switch */
    .mc-switch { display: flex; gap: 12px; align-items: flex-start; cursor: pointer; margin-bottom: 14px; }
    .mc-switch input { position: absolute; opacity: 0; width: 1px; height: 1px; }
    .mc-switch .track { flex: 0 0 40px; height: 22px; border-radius: 99px; background: #cbd5e1; position: relative; transition: background .2s; margin-top: 1px; }
    .mc-switch .track::after { content: ""; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.25); transition: transform .2s; }
    .mc-switch input:checked + .track { background: var(--mc-brand); }
    .mc-switch input:checked + .track::after { transform: translateX(18px); }
    .mc-switch input:focus-visible + .track { box-shadow: 0 0 0 3px rgba(37,99,235,.25); }
    .mc-switch b { display: block; color: var(--mc-ink); font-weight: 600; font-size: .92rem; }
    .mc-switch span.hint { display: block; color: var(--mc-muted); font-size: .82rem; margin-top: 2px; }

    /* Radio cards */
    .mc-choices { display: grid; gap: 10px; }
    .mc-choice { display: flex; gap: 12px; align-items: flex-start; border: 1.5px solid var(--mc-line); border-radius: 12px; padding: 12px 14px; cursor: pointer; transition: border-color .15s, background .15s; margin: 0; }
    .mc-choice:hover { border-color: #94a3b8; }
    .mc-choice input { margin-top: 4px; accent-color: var(--mc-brand); }
    .mc-choice:has(input:checked) { border-color: var(--mc-brand); background: var(--mc-brand-soft); }
    .mc-choice b { display: block; color: var(--mc-ink); font-weight: 600; font-size: .92rem; }
    .mc-choice span { color: var(--mc-muted); font-size: .82rem; }

    /* KPIs */
    .mc-kpis { display: grid; grid-template-columns: minmax(280px, 1.4fr) repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 20px; }
    @@media (max-width: 1200px) { .mc-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } .mc-kpis .mc-kpi.ring { grid-column: span 2; } }
    .mc-kpi { background: #fff; border: 1px solid var(--mc-line); border-radius: var(--mc-radius); padding: 18px; box-shadow: var(--mc-shadow); display: flex; flex-direction: column; justify-content: center; text-decoration: none !important; color: inherit !important; transition: transform .15s, box-shadow .15s; }
    a.mc-kpi:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(15,23,42,.08); }
    .mc-kpi .label { color: var(--mc-muted); font-size: .82rem; font-weight: 600; display: flex; align-items: center; gap: 7px; }
    .mc-kpi .value { font-size: 2rem; font-weight: 750; color: var(--mc-ink); line-height: 1.15; margin-top: 6px; font-variant-numeric: tabular-nums; }
    .mc-kpi .value small { font-size: 1rem; color: var(--mc-muted); font-weight: 600; }
    .mc-kpi.bad .value { color: var(--mc-bad); } .mc-kpi.warn .value { color: var(--mc-warn); } .mc-kpi.good .value { color: var(--mc-ok); }
    .mc-kpi .bar { height: 6px; background: #f1f5f9; border-radius: 99px; overflow: hidden; margin-top: 10px; }
    .mc-kpi .bar i { display: block; height: 100%; background: var(--mc-brand); border-radius: 99px; }
    .mc-kpi.ring { flex-direction: row; align-items: center; gap: 16px; }
    .mc-ring { position: relative; width: 92px; height: 92px; flex: 0 0 92px; }
    .mc-ring svg { transform: rotate(-90deg); }
    .mc-ring circle.fg { transition: stroke-dasharray 1s ease; }
    .mc-ring b { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 1.35rem; font-weight: 800; color: var(--mc-ink); }

    /* Checklist */
    .mc-checklist { list-style: none; margin: 0; padding: 0; }
    .mc-checklist li { display: flex; align-items: center; gap: 12px; padding: 11px 0; border-top: 1px solid var(--mc-line); }
    .mc-checklist li:first-child { border-top: 0; padding-top: 0; }
    .mc-checklist .tick { flex: 0 0 26px; height: 26px; border-radius: 50%; border: 2px solid #cbd5e1; display: flex; align-items: center; justify-content: center; font-size: .72rem; color: transparent; }
    .mc-checklist li.done .tick { background: var(--mc-ok); border-color: var(--mc-ok); color: #fff; }
    .mc-checklist li.done .what { color: var(--mc-muted); text-decoration: line-through; text-decoration-color: #cbd5e1; }
    .mc-checklist .what { flex: 1; min-width: 0; font-weight: 550; color: var(--mc-ink); }
    .mc-checklist .what small { display: block; font-weight: 400; color: var(--mc-muted); text-decoration: none; }
    .mc-alldone { display: flex; gap: 10px; align-items: center; background: var(--mc-ok-bg); color: #166534; border-radius: 10px; padding: 12px 14px; font-weight: 550; margin-top: 12px; }

    /* Feed cards */
    .mc-feeds { display: grid; grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); gap: 20px; margin-bottom: 20px; }
    @@media (max-width: 560px) { .mc-feeds { grid-template-columns: 1fr; } }
    .mc-feed { background: #fff; border: 1px solid var(--mc-line); border-radius: var(--mc-radius); box-shadow: var(--mc-shadow); display: flex; flex-direction: column; overflow: hidden; }
    .mc-feed-head { display: flex; align-items: center; gap: 12px; padding: 18px 20px 12px; }
    .mc-flag { width: 36px; height: auto; max-height: 26px; border-radius: 4px; box-shadow: 0 0 0 1px rgba(15,23,42,.08); flex: 0 0 auto; object-fit: cover; }
    .mc-feed-head h3 { font-size: 1.08rem; margin: 0; font-weight: 700; }
    .mc-feed-head .meta { color: var(--mc-muted); font-size: .82rem; }
    .mc-feed-head .mc-pill { margin-left: auto; }
    .mc-feed-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--mc-line); border-top: 1px solid var(--mc-line); border-bottom: 1px solid var(--mc-line); }
    .mc-feed-stats div { background: #fff; padding: 12px 20px; }
    .mc-feed-stats b { display: block; font-size: 1.35rem; font-weight: 750; color: var(--mc-ink); font-variant-numeric: tabular-nums; }
    .mc-feed-stats span { font-size: .78rem; color: var(--mc-muted); font-weight: 600; }
    .mc-feed-stats .bad b { color: var(--mc-bad); } .mc-feed-stats .warn b { color: var(--mc-warn); }
    .mc-feed-body { padding: 16px 20px; display: grid; gap: 12px; flex: 1; }
    .mc-url { display: flex; border: 1px solid #cbd5e1; border-radius: 10px; overflow: hidden; background: var(--mc-soft); }
    .mc-url input { flex: 1; min-width: 0; border: 0; background: transparent; padding: 8px 12px; font-family: SFMono-Regular, Consolas, monospace; font-size: .8rem; color: var(--mc-text); }
    .mc-url input:focus { outline: 0; }
    .mc-url button { border: 0; border-left: 1px solid #cbd5e1; background: #fff; padding: 0 14px; font-weight: 600; font-size: .85rem; color: var(--mc-brand); cursor: pointer; white-space: nowrap; }
    .mc-url button:hover { background: var(--mc-brand-soft); }
    .mc-url button.copied { color: var(--mc-ok); }
    .mc-feed-foot { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 12px 20px 16px; }
    .mc-feed-foot .mc-spacer { margin-left: auto; }
    .mc-feed-error { background: var(--mc-bad-bg); color: #991b1b; border-radius: 10px; padding: 10px 12px; font-size: .85rem; }
    .mc-addfeed { border: 2px dashed #cbd5e1; border-radius: var(--mc-radius); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; min-height: 150px; color: var(--mc-muted) !important; text-decoration: none !important; transition: all .15s; background: transparent; }
    .mc-addfeed:hover { border-color: var(--mc-brand); color: var(--mc-brand) !important; background: var(--mc-brand-soft); }
    .mc-addfeed i { font-size: 1.6rem; }
    .mc-addfeed b { font-size: 1rem; }

    /* Progress */
    .mc-progress { display: none; }
    .mc-progress.on { display: block; }
    .mc-progress .track { height: 8px; background: #e2e8f0; border-radius: 99px; overflow: hidden; }
    .mc-progress .fill { height: 100%; width: 0; background: linear-gradient(90deg, #3b82f6, #2563eb); border-radius: 99px; transition: width .4s ease; position: relative; }
    .mc-progress .fill.indeterminate { width: 35% !important; animation: mc-slide 1.2s ease-in-out infinite; }
    @@keyframes mc-slide { 0% { margin-left: -35%; } 100% { margin-left: 100%; } }
    .mc-progress .text { display: flex; justify-content: space-between; font-size: .8rem; color: var(--mc-muted); margin-top: 6px; font-variant-numeric: tabular-nums; }

    /* Problem list */
    .mc-problems { list-style: none; margin: 0; padding: 0; }
    .mc-problems li { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-top: 1px solid var(--mc-line); }
    .mc-problems li:first-child { border-top: 0; }
    .mc-problems .what { flex: 1; min-width: 0; }
    .mc-problems .what b { display: block; color: var(--mc-ink); font-weight: 600; font-size: .92rem; }
    .mc-problems .what span { font-size: .82rem; color: var(--mc-muted); display: block; }
    .mc-problems .count { font-weight: 750; font-variant-numeric: tabular-nums; color: var(--mc-ink); min-width: 48px; text-align: right; }
    .mc-group-label { font-size: .74rem; text-transform: uppercase; letter-spacing: .06em; font-weight: 700; color: var(--mc-muted); margin: 14px 0 4px; }
    .mc-group-label:first-child { margin-top: 0; }

    /* Tables */
    .mc-table { width: 100%; border-collapse: separate; border-spacing: 0; }
    .mc-table th { font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; color: var(--mc-muted); font-weight: 700; padding: 10px 12px; border-bottom: 1px solid var(--mc-line); text-align: left; background: var(--mc-soft); }
    .mc-table td { padding: 12px; border-bottom: 1px solid var(--mc-line); vertical-align: middle; }
    .mc-table tr:last-child td { border-bottom: 0; }
    .mc-table tr:hover td { background: #fcfdff; }
    .mc-table-wrap { border: 1px solid var(--mc-line); border-radius: var(--mc-radius); overflow: auto; background: #fff; box-shadow: var(--mc-shadow); }
    .mc-thumb { width: 52px; height: 52px; border-radius: 10px; object-fit: cover; border: 1px solid var(--mc-line); background: var(--mc-soft); flex: 0 0 auto; }
    .mc-product { display: flex; gap: 12px; align-items: center; min-width: 220px; }
    .mc-product b { display: block; color: var(--mc-ink); font-weight: 600; }
    .mc-product span { font-size: .8rem; color: var(--mc-muted); }
    .mc-issue { display: flex; gap: 8px; align-items: flex-start; margin: 3px 0; }
    .mc-issue .mc-pill { margin-top: 1px; }
    .mc-issue details summary { cursor: pointer; list-style: none; font-weight: 550; color: var(--mc-ink); }
    .mc-issue details summary::-webkit-details-marker { display: none; }
    .mc-issue details summary::after { content: " \f107"; font-family: "Font Awesome 5 Free"; font-weight: 900; color: var(--mc-muted); font-size: .8em; }
    .mc-issue details p { margin: 4px 0 6px; font-size: .84rem; color: var(--mc-muted); max-width: 520px; }
    .mc-excluded td { opacity: .55; }
    .mc-toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 16px; }
    .mc-toolbar .mc-input { max-width: 320px; }
    .mc-toolbar .mc-spacer { margin-left: auto; }
    .mc-search { position: relative; }
    .mc-search i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--mc-muted); pointer-events: none; }
    .mc-search .mc-input { padding-left: 34px; }
    .mc-pager { display: flex; gap: 8px; align-items: center; justify-content: flex-end; margin-top: 14px; color: var(--mc-muted); font-size: .88rem; }

    /* Callout */
    .mc-callout { display: flex; gap: 12px; border-radius: 12px; padding: 14px 16px; margin-bottom: 16px; border: 1px solid; font-size: .92rem; }
    .mc-callout > i { margin-top: 3px; }
